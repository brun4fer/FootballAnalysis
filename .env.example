DATABASE_URL=postgres://user:password@localhost:5432/football_analysis

# Shared private video library. Use the same media database and R2 bucket as the
# Player, Team and Opponent applications, but a token restricted to this app.
MEDIA_LIBRARY_APP_ID=goals-scored-analysis
MEDIA_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
MEDIA_DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
MEDIA_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_R2_BUCKET_NAME=football-analysis-media-prod
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# One-time local bootstrap only. Never add these values to Vercel or commit real passwords.
BOOTSTRAP_PAULO_PASSWORD=
BOOTSTRAP_SIMAO_PASSWORD=
